        {
            switch (cmbBitRate.Text)
            {
                case "1 Mbps":
                    return 1.0;

                case "2 Mbps":
                    return 2.0;

                case "5 Mbps":
                    return 5.0;

                case "10 Mbps":
                    return 10.0;

                case "25 Mbps":
                    return 25.0;

                case "50 Mbps":
                    return 50.0;

                default:
                    return 0.0;
            }
        }

        private double CalculatePayloadRate(double lineRateMbps)
        {
            switch (cmbCode.Text)
            {
                case "None":
                    return lineRateMbps;

                case "Repeat-3":
                    return lineRateMbps / 3.0;

                case "CRC-8":
                    return lineRateMbps / 2.0;

                case "Hamming-7,4":
                    return lineRateMbps * 4.0 / 7.0;

                default:
                    return 0.0;
            }
        }

