        private string FormatPacketAscii(byte[] data)
        {
            StringBuilder ascii = new StringBuilder();

            for (int i = 0; i < data.Length; i++)
            {
                byte b = data[i];

                if (b >= 0x20 && b <= 0x7E)
                    ascii.Append((char)b);
                else
                    ascii.Append(".");
            }

            return ascii.ToString() + " [" + BitConverter.ToString(data) + "]";
        }

