        private bool IsWithinMeasuredRxLimit()
        {
            double rate = GetSelectedLineRateMbps();

            switch (cmbMod.Text)
            {
                case "OOK-NRZ":
                    return rate <= 50.0;

                case "OOK-RZ":
                    return rate <= 10.0;

                case "PWM":
                case "PPM":
                    return rate <= 5.0;

                default:
                    return false;
            }
